{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure STM32 CMake",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-G", "Ninja"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build STM32",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Flash STM32",
      "type": "shell",
      "command": "/opt/ST/STM32CubeCLT_1.21.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI",
      "args": [
        "-c", "port=SWD",
        "-w", "build/Light_Sensor.elf",
        "-rst"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build and Flash STM32",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build STM32",
        "Flash STM32"
      ],
      "problemMatcher": []
    },
    {
      "label": "Clean Build Folder",
      "type": "shell",
      "command": "rm",
      "args": [
        "-rf",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}